<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputPath>obj\deploy\</OutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>None</DebugType>
    <LangVersion>latest</LangVersion>
    <Nullable>warnings</Nullable>
	  <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>ChangeName</RootNamespace>
    <AssemblyName>ChangeName</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony">
      <Version>*</Version>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\..\..\Assembly-CSharp.dll</HintPath>
      <CopyLocal>false</CopyLocal>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimWorld">
      <HintPath>..\..\..\..\RimWorld.dll</HintPath>
	   <CopyLocal>false</CopyLocal>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>..\..\..\..\UnityStubs.dll</HintPath>
	   <CopyLocal>false</CopyLocal>
      <Private>False</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>..\..\..\..\Waylith.dll</HintPath>
	   <CopyLocal>false</CopyLocal>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToAssemblies" AfterTargets="Build">
    <Exec Command='if not exist "$(MSBuildThisFileDirectory)obj\trash" mkdir "$(MSBuildThisFileDirectory)obj\trash"' IgnoreExitCode="true" />
    <Exec Command='del /f /q "$(MSBuildThisFileDirectory)obj\trash\$(AssemblyName).dll*" >nul 2>nul' IgnoreExitCode="true" />
    <Exec Command='if exist "$(MSBuildThisFileDirectory)..\Assemblies\$(AssemblyName).dll*" move /y "$(MSBuildThisFileDirectory)..\Assemblies\$(AssemblyName).dll*" "$(MSBuildThisFileDirectory)obj\trash\"' IgnoreExitCode="true" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll" DestinationFiles="$(MSBuildThisFileDirectory)..\Assemblies\$(AssemblyName).dll" />
  </Target>

</Project>
